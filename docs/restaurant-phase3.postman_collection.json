						},
						"url": {
							"raw": "{{order_base}}/orders",
							"host": ["{{order_base}}"],
							"path": ["orders"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 400', () => pm.response.to.have.status(400));",
									"pm.test('Error is ValidationError', () => pm.expect(pm.response.json().error).to.eql('ValidationError'));"
								]
							}
						}
					]
				},
				{
					"name": "GET Order by random id (expect 404)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{order_base}}/orders/00000000-0000-0000-0000-000000000000",
							"host": ["{{order_base}}"],
							"path": ["orders", "00000000-0000-0000-0000-000000000000"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 404', () => pm.response.to.have.status(404));"
								]
							}
						}
					]
				}
			]
		}
