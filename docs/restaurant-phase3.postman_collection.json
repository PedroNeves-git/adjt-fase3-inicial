		{
			"name": "1. Auth",
			"item": [
				{
					"name": "POST Register Client",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Pedro Test\",\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\",\n    \"role\": \"CLIENT\"\n}"
						},
						"url": {
							"raw": "{{auth_base}}/users",
							"host": ["{{auth_base}}"],
							"path": ["users"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Created (2xx) or Conflict (409 if already exists)', function () {",
									"    pm.expect([200, 201, 409, 400]).to.include(pm.response.code);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "POST Login (saves token)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n}"
						},
						"url": {
							"raw": "{{auth_base}}/auth/login",
							"host": ["{{auth_base}}"],
							"path": ["auth", "login"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test('Has accessToken', () => pm.expect(body.accessToken).to.be.a('string'));",
									"pm.collectionVariables.set('token', body.accessToken);",
									"console.log('Token saved (length ' + body.accessToken.length + ')');"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "2. Menu",
			"item": [
				{
					"name": "GET List menu items",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{order_base}}/menu-items",
							"host": ["{{order_base}}"],
							"path": ["menu-items"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"const items = pm.response.json();",
									"pm.test('Has 12 active items', () => pm.expect(items.length).to.eql(12));",
									"pm.test('All items are active', () => items.forEach(i => pm.expect(i.active).to.be.true));"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "3. Orders",
			"item": [
				{
					"name": "POST Create order (saves order_id)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"restaurantId\": \"{{restaurant_id}}\",\n    \"items\": [\n        { \"menuItemId\": \"{{menu_item_burger}}\", \"quantity\": 2 },\n        { \"menuItemId\": \"{{menu_item_coke}}\",   \"quantity\": 1 }\n    ]\n}"
						},
						"url": {
							"raw": "{{order_base}}/orders",
							"host": ["{{order_base}}"],
							"path": ["orders"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 201', () => pm.response.to.have.status(201));",
									"const body = pm.response.json();",
									"pm.test('Status is AWAITING_CONFIRMATION', () => pm.expect(body.status).to.eql('AWAITING_CONFIRMATION'));",
									"pm.test('Has computed totalAmount', () => pm.expect(Number(body.totalAmount)).to.be.greaterThan(0));",
									"pm.test('Has 2 items', () => pm.expect(body.items.length).to.eql(2));",
									"pm.collectionVariables.set('order_id', body.id);",
									"console.log('Order created with id ' + body.id + ', total ' + body.totalAmount);"
								]
							}
						}
					]
				},
				{
					"name": "POST Confirm order (publishes pedido.criado)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{order_base}}/orders/{{order_id}}/confirm",
							"host": ["{{order_base}}"],
							"path": ["orders", "{{order_id}}", "confirm"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test('Status is PENDING_PAYMENT', () => pm.expect(body.status).to.eql('PENDING_PAYMENT'));"
								]
							}
						}
					]
				},
				{
					"name": "GET Order by id",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{order_base}}/orders/{{order_id}}",
							"host": ["{{order_base}}"],
							"path": ["orders", "{{order_id}}"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"console.log('Current order status: ' + pm.response.json().status);"
								]
							}
						}
					]
				},
				{
					"name": "GET My orders",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{order_base}}/orders",
							"host": ["{{order_base}}"],
							"path": ["orders"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Returns an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
								]
							}
						}
					]
				},
				{
					"name": "GET Order by id (expect PAID after payment-service processes)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{order_base}}/orders/{{order_id}}",
							"host": ["{{order_base}}"],
							"path": ["orders", "{{order_id}}"]
						},
						"description": "Run this 3-10 seconds AFTER 'POST Confirm order'. The payment-service should have consumed pedido.criado, called procpag and published pagamento.aprovado, which is then consumed by order-service to mark the order as PAID."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"const status = pm.response.json().status;",
									"console.log('Current order status: ' + status);",
									"pm.test('Eventually PAID (re-run if still PENDING_PAYMENT)', function () {",
									"    pm.expect(status).to.be.oneOf(['PAID', 'PENDING_PAYMENT']);",
									"    if (status === 'PENDING_PAYMENT') {",
									"        console.warn('Still PENDING_PAYMENT — payment-service may still be processing. Wait a few seconds and rerun.');",
									"    }",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "4. Payment monitoring (Resilience4j)",
			"item": [
				{
					"name": "GET payment-service Circuit Breakers",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{payment_base}}/actuator/circuitbreakers",
							"host": ["{{payment_base}}"],
							"path": ["actuator", "circuitbreakers"]
						},
						"description": "Shows the state of all Circuit Breakers managed by Resilience4j. The 'procpag' CB protects calls to the external payment provider. States: CLOSED (normal), OPEN (too many failures, blocking calls), HALF_OPEN (test recovery)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"console.log('CircuitBreakers: ' + JSON.stringify(body, null, 2));",
									"pm.test('procpag circuit breaker registered', function () {",
									"    pm.expect(body.circuitBreakers).to.have.property('procpag');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "GET payment-service Retries",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{payment_base}}/actuator/retries",
							"host": ["{{payment_base}}"],
							"path": ["actuator", "retries"]
						},
						"description": "Shows Resilience4j Retry instances. The 'procpag' retry runs up to 2 attempts on IOException/ConnectException/ResourceAccessException with 300ms backoff."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"console.log(JSON.stringify(pm.response.json(), null, 2));"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "5. Error scenarios",
