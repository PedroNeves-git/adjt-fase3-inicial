						},
						"url": {
							"raw": "{{order_base}}/orders",
							"host": ["{{order_base}}"],
							"path": ["orders"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Rejected (401 or 403)', () => pm.expect([401, 403]).to.include(pm.response.code));"
								]
							}
						}
					]
				},
				{
					"name": "POST Create order - empty items (expect 400)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
