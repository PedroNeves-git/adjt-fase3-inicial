							"host": ["{{payment_base}}"],
							"path": ["actuator", "health"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Status is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
								]
							}
